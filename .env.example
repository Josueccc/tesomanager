# Base de datos PostgreSQL
POSTGRES_USER=teso
POSTGRES_PASSWORD=teso
POSTGRES_DB=tesomanager
# Puerto local (solo 127.0.0.1) donde se expone PostgreSQL al host
DB_PORT=5432

# Clave para firmar las sesiones (cámbiala por una cadena larga y aleatoria)
SECRET_KEY=cambia-esta-clave-por-algo-largo-y-aleatorio

# Usuario tesorero inicial (se crea automáticamente al primer arranque)
ADMIN_EMAIL=tesorero@iglesia.local
ADMIN_PASSWORD=cambiar123
ADMIN_NOMBRE=Tesorero

# Puerto del host donde se publica la app (cámbialo si el 8000 está ocupado)
APP_PORT=8000
